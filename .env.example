# Local Docker defaults; no secret is required for graph-grounded mode.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=launchlens

# Optional: if set, OpenAI synthesizes a natural-language answer from live graph evidence.
# Leave blank to use the deterministic graph-grounded agent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
